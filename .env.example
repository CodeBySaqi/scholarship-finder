# Copy to .env for local development. Never commit .env.
# On Render these are set in the dashboard (Dashboard → your service → Environment).

# --- Database (optional locally, required in production) ---------------------
# Leave both empty to use data/db.json on disk (local development, audits).
# Set both and the app reads and writes the hosted Postgres instead, which is
# what makes a redeploy safe on a host with an ephemeral filesystem.
#
# Supabase dashboard → Project Settings → API:
#   Project URL            → SUPABASE_URL
#   service_role secret    → SUPABASE_SERVICE_ROLE_KEY   (server only, never the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ----------------------------------------------------------------
# Signs the session cookie. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SF_SECRET=

# --- Server ------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# Debounce before a change is pushed to Supabase (ms). 300 is fine.
STORE_SYNC_DEBOUNCE_MS=300
